{
  "dsl_version": 1,
  "target_schema_version": 1,
  "name": "swe-chat-conversations-v1",
  "source": "swe-chat",
  "input_format": "parquet",
  "rules": [
    {
      "id": "session",
      "entity": "session",
      "select": "$",
      "where": [
        {
          "path": "$.is_first_turn",
          "op": "eq",
          "value": true
        }
      ],
      "fields": {
        "external_id": {
          "path": "$.session_id"
        },
        "agent": {
          "path": "$.agent"
        },
        "repo": {
          "path": "$.repo_id"
        },
        "user": {
          "path": "$.user_id"
        },
        "started_at": {
          "path": "$.timestamp.iso",
          "timestamp_format": "iso8601"
        }
      }
    },
    {
      "id": "model_call",
      "entity": "model_call",
      "select": "$",
      "where": [
        {
          "path": "$.role",
          "op": "eq",
          "value": "assistant"
        }
      ],
      "fields": {
        "session_external_id": {
          "path": "$.session_id"
        },
        "external_id": {
          "path": "$.turn_id"
        },
        "model": {
          "path": "$.model"
        },
        "input_tokens": {
          "path": "$.input_tokens"
        },
        "output_tokens": {
          "path": "$.output_tokens"
        },
        "cache_creation_tokens": {
          "path": "$.cache_creation_input_tokens"
        },
        "cache_read_tokens": {
          "path": "$.cache_read_input_tokens"
        },
        "started_at": {
          "path": "$.timestamp.iso",
          "timestamp_format": "iso8601"
        },
        "sequence": {
          "path": "$.turn_number"
        }
      }
    },
    {
      "id": "tool_call",
      "entity": "tool_call",
      "select": "$",
      "where": [
        {
          "path": "$.role",
          "op": "eq",
          "value": "tool_use"
        }
      ],
      "fields": {
        "session_external_id": {
          "path": "$.session_id"
        },
        "external_id": {
          "path": "$.tool_call_id"
        },
        "tool_name": {
          "path": "$.tool_name"
        },
        "started_at": {
          "path": "$.timestamp.iso",
          "timestamp_format": "iso8601"
        },
        "sequence": {
          "path": "$.turn_number"
        }
      }
    }
  ],
  "unmapped": [
    {
      "path": "session.ended_at",
      "reason": "No session-level end timestamp exists in the source; only per-turn timestamps are recorded."
    },
    {
      "path": "model_call.provider",
      "reason": "Source has no provider label; only a model string (e.g. claude-opus-4-6)."
    },
    {
      "path": "model_call.is_error",
      "reason": "No error flag field in the source."
    },
    {
      "path": "model_call.error_message",
      "reason": "No error message field in the source."
    },
    {
      "path": "model_call.reasoning_tokens",
      "reason": "No reasoning-token counter in the source."
    },
    {
      "path": "model_call.token_semantics",
      "reason": "Source does not document what the token counters mean; left unvalidated."
    },
    {
      "path": "tool_call.status",
      "reason": "No status label in the source (category/bash_category are tool-type labels, not call status)."
    },
    {
      "path": "tool_call.is_error",
      "reason": "No error flag in the source."
    },
    {
      "path": "tool_call.exit_code",
      "reason": "No exit code in the source."
    },
    {
      "path": "tool_call.internal_latency_ms",
      "reason": "No runner-reported latency in the source."
    },
    {
      "path": "tool_call.wall_latency_ms",
      "reason": "No wall-clock latency in the source."
    }
  ],
  "notes": "SWE-chat conversations: assistant rows are model calls, tool_use rows are tool calls; token semantics unknown. Reviewed 2026-09-07. Reviewer correction after the run (2026-09-07 late): tool_call.ended_at and model_call.ended_at <- $.timestamp.iso removed (a row's timestamp is one instant, the start; the result arrives on another row the mapping cannot join, so ends stay null)."
}
