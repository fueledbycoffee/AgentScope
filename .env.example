# Copy to backend/.env (gitignored). Never commit real keys.

# --- LLM used by the import-mapping assistant -------------------------------
# Provider adapter: openai_compatible | fake. "fake" is the deterministic offline
# assistant used by the tests and demos; it never calls a network. With any other
# value the application starts normally and only assistant runs answer 503 until
# that adapter exists (openai_compatible is issue #14).
AGENTSCOPE_LLM_PROVIDER=openai_compatible
# Any chat-completions-compatible endpoint. Examples:
#   OpenRouter : https://openrouter.ai/api/v1
#   LM Studio  : http://localhost:1234/v1
#   Ollama     : http://localhost:11434/v1
AGENTSCOPE_LLM_BASE_URL=https://openrouter.ai/api/v1
# Model id as the endpoint expects it (never hard-coded in the application).
AGENTSCOPE_LLM_MODEL=minimax/minimax-m3:free
# Leave empty for local servers that need no key.
AGENTSCOPE_LLM_API_KEY=

# --- Storage -----------------------------------------------------------------
AGENTSCOPE_DATABASE_URL=sqlite:///./data/agentscope.sqlite3
AGENTSCOPE_RAW_FILE_DIR=./data/raw-files

# --- Server ------------------------------------------------------------------
AGENTSCOPE_HOST=127.0.0.1
AGENTSCOPE_PORT=8000
