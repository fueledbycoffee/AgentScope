# Copy to backend/.env (gitignored). Never commit real keys.

# --- LLM used by the import-mapping assistant -------------------------------
# Provider adapter: openai_compatible | fake | none. "openai_compatible" talks to any
# chat-completions endpoint (OpenRouter, LM Studio, Ollama). The example below
# names a real hosted model but deliberately leaves the key empty: the app will
# start, but the first assistant call will fail authentication unless you add a
# valid key. Use "fake" for the deterministic offline assistant used by tests
# and demos; it needs no key and never calls a network. "none" disables the
# assistant. The application always starts; with a missing model or an unknown
# provider only assistant runs answer 503.
AGENTSCOPE_LLM_PROVIDER=openai_compatible
# Any chat-completions-compatible endpoint. Examples:
#   OpenRouter : https://openrouter.ai/api/v1
#   LM Studio  : http://localhost:1234/v1
#   Ollama     : http://localhost:11434/v1
AGENTSCOPE_LLM_BASE_URL=https://openrouter.ai/api/v1
# Model id as the endpoint expects it (never hard-coded in the application). Free
# OpenRouter models come and go: minimax/minimax-m3:free left the free tier on
# 2026-09-07; this one produced an executable proposal on 2026-09-08 with the
# budget and deadline below (see docs/llm/configuration.md for the evidence table
# and dots-studio/dots-3-note-preview:free as an alternative).
AGENTSCOPE_LLM_MODEL=inclusionai/ling-3.0-flash-fin:free
# Leave empty for local servers that need no key.
AGENTSCOPE_LLM_API_KEY=
# Deadline of one generation call in seconds (connect is always 10 s). Free hosted
# reasoning models need minutes, not seconds.
AGENTSCOPE_LLM_TIMEOUT_S=240
# Structured output: auto (send response_format, fall back once if the server rejects it),
# on (always send it), off (rely on the prompt; some local builds need this).
AGENTSCOPE_LLM_JSON_MODE=auto
# Upper bound on the reply; a cut-off reply gets one repair attempt, then fails clearly.
# Reasoning models spend this budget on hidden thinking first: 8192 cut Ling 3.0 off
# with no content at all; the failure message says so when it happens.
AGENTSCOPE_LLM_MAX_TOKENS=32768

# --- Storage -----------------------------------------------------------------
AGENTSCOPE_DATABASE_URL=sqlite:///./data/agentscope.sqlite3
AGENTSCOPE_RAW_FILE_DIR=./data/raw-files

# --- Server ------------------------------------------------------------------
AGENTSCOPE_HOST=127.0.0.1
AGENTSCOPE_PORT=8000
